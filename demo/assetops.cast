[0.002, "o", "  \u001b[32m→\u001b[0m highest-criticality assets: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-1'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m9\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-2'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m9\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-3'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-4'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m8\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'AHU-1'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m7\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
