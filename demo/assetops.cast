[1.406, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33me:E\u001b[0m\u001b[33mquipment \u001b[0m\u001b[1;33m{\u001b[0m\u001b[33mname: \u001b[0m\r\n\u001b[33m\"Pump-CW-1\"\u001b[0m\u001b[1;33m}\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m<-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:DEPENDS_ON*\u001b[0m\u001b[1;33m1\u001b[0m\u001b[33m..\u001b[0m\u001b[1;33m3\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md:E\u001b[0m\u001b[33mquipment\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN DISTINCT d.name AS \u001b[0m\r\n\u001b[33mimpacted, d.criticality_score AS criticality ORDER BY criticality DESC\u001b[0m\r\n"]
[0.002, "o", "  \u001b[32m→\u001b[0m downstream assets isolated by one pump failure: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-1'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m9\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-2'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m9\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'AHU-1'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m7\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'AHU-2'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m7\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
