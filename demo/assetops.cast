[0.605, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\r\n\u001b[1;33m(\u001b[0m\u001b[1;33ma:A\u001b[0m\u001b[33mnomaly\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:TRIGGERED\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mw:WorkOrder\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:FOR_EQUIPMENT\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33me:E\u001b[0m\u001b[33mquipment\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE \u001b[0m\r\n\u001b[33ma.severity = \u001b[0m\u001b[33m\"high\"\u001b[0m\u001b[33m AND w.priority < \u001b[0m\u001b[1;33m2.0\u001b[0m\u001b[33m RETURN e.name AS asset, w.description \u001b[0m\r\n\u001b[33mAS work_order ORDER BY asset LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.001, "o", "  \u001b[32m→\u001b[0m priority-\u001b[1;36m1\u001b[0m work orders from high-severity anomalies: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Chiller-1'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;32m'Chiller-1 compressor overheating - emergency repair'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Boiler-1'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Boiler-1 \u001b[0m\r\n\u001b[1;32mburner instability - adjustment needed'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Pump-CW-1'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;32m'Pump-CW-1 impeller \u001b[0m\r\n\u001b[1;32mcavitation repair'\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
